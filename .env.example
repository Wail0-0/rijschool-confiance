# Kopieer naar .env (lokaal) of zet deze variabelen in Coolify.
# Zet NOOIT de echte API-key in de code of in git.

# Vereist: je Resend API-key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optioneel: ontvanger van de aanmeldingen (standaard Rijschoolconfiance@gmail.com)
MAIL_TO=Rijschoolconfiance@gmail.com

# Optioneel: afzender. Gebruik een geverifieerd domein in Resend, bijv.
# "Rijschool Confiance <aanmelding@rijschoolconfiance.nl>".
# Zonder geverifieerd domein kun je tijdelijk onboarding@resend.dev gebruiken.
MAIL_FROM=Rijschool Confiance <onboarding@resend.dev>

# Optioneel: poort (standaard 3000)
PORT=3000
